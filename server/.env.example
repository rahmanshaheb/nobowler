# Copy to .env and fill in real values. Never commit the real .env file.

DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-string
SUPER_ADMIN_KEY=replace-with-a-separate-long-random-string
PORT=3000
NODE_ENV=development

# Used only by db/seed.js when first setting up the admin account.
# The admin password itself is fixed in code (db/seed.js) and not
# configurable here — see authRoutes.js for why.
ADMIN_EMAIL=admin@example.com
DEFAULT_SCORER_PASSCODE=0000
